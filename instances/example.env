GEMINI_API_KEY=coloque_a_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# Nome de exibição usado nas mensagens (ex: "Oii Guilherme 😊"). Se vazio,
# usa o nome da instância com a primeira letra maiúscula.
DISPLAY_NAME=

# Nome exato do grupo no WhatsApp (incluindo emoji, se tiver). Deixe vazio
# para usar a conversa "Mensagens para você mesmo" em vez de um grupo.
GROUP_NAME=

# Horário (HH:mm) do resumo matinal com a agenda do dia. Deixe vazio para
# não enviar resumo matinal.
DIGEST_TIME=07:30

# Opcional: preencha com o número de telefone da pessoa (só dígitos, com
# código do país, ex: 5511999999999) para parear por CÓDIGO em vez de QR code.
# Deixe vazio/comentado para usar QR code (padrão).
# PHONE_NUMBER=5511999999999
